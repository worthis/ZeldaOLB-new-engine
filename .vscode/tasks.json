{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Switch NRO (Parallel)",
      "type": "shell",
      "command": "make",
      "args": ["-f", "Makefile.switch", "-j$(nproc)"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Clean Switch Build",
      "type": "shell",
      "command": "make",
      "args": ["-f", "Makefile.switch", "clean"],
      "problemMatcher": []
    },
    {
      "label": "Rebuild Switch NRO (Clean + Build)",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "make -f Makefile.switch clean && make -f Makefile.switch -j$(nproc)"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}